    "start": "electron .",
    "dev": "electronmon .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@supabase/supabase-js": "^2.75.1",
    "@vitalets/google-translate-api": "^9.2.1",
    "active-win": "^8.2.1",
    "axios": "^1.12.2",
    "clipboardy": "^4.0.0",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "^5.2.0",
    "form-data": "^4.0.3",
    "node-fetch": "^2.7.0",
    "ollama": "^0.6.2",
    "play-dl": "^1.9.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "robotjs": "^0.6.0",
    "screenshot-desktop": "^1.15.3",
    "sentiment": "^5.0.2",
    "sharp": "^0.34.2",
    "string-similarity": "^4.0.4",
    "supabase": "^2.51.0",
    "tesseract.js": "^6.0.1",
    "tmp": "^0.2.5",
    "windows-shortcuts": "^0.1.6",
    "youtube-sr": "^4.3.12",
    "youtube-transcript": "^1.2.1"
  },
  "devDependencies": {
    "@electron/remote": "^2.1.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9",
    "electronmon": "^2.0.3",
    "nodemon": "^3.1.10"
